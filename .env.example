# From the Supabase dashboard: click Connect (or Settings > API Keys).
# Only the PUBLISHABLE key (sb_publishable_...) belongs here. It is safe to expose to browsers.
# NEVER put a secret key (sb_secret_...) or the legacy service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
